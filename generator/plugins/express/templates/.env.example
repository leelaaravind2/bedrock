# Optional overrides. docker-compose.yml already sets working defaults, so the
# project runs without any .env file. Copy to .env to customise.

# Database
PGHOST=localhost
PGPORT=5432
PGDATABASE=__DB_NAME__
PGUSER=__DB_USER__
PGPASSWORD=__DB_PASSWORD__

# Seed login user (simple login)
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=admin123
