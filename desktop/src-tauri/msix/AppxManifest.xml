<?xml version="1.0" encoding="utf-8"?>
<!--
  Bedrock — MSIX package manifest (Eco-Day 55).

  MSIX is NOT a Tauri v2 bundle target (tauri build = msi/nsis only). This manifest +
  the wrap recipe in README.md are the EXTERNAL wrap path: take the `tauri build` payload
  (Bedrock.exe + the bundled node sidecar + resources/gen) into an MSIX layout, then run
  the Windows SDK `MakeAppx.exe pack`. Microsoft signs at Store certification — there is
  NO cert/EV/token/notarization on the release path.

  PLACEHOLDERS ({{...}}) are Partner-Center-assigned — they are NOT invented here. Fill
  them from Partner Center before wrapping (see README.md → "Placeholders").
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Identity: Name + Publisher are ASSIGNED BY PARTNER CENTER when the app/name is
       reserved. Do NOT invent them. Version is 4-part (Store requires the 4th = 0). -->
  <Identity
    Name="{{STORE_IDENTITY_NAME}}"
    Publisher="{{STORE_PUBLISHER_CN}}"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Bedrock</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Win10 2004 (19041) baseline; WebView2 runtime is present on Windows 11. -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- A packaged Win32/desktop-bridge app: the Tauri exe is the entry point. -->
    <Application Id="Bedrock" Executable="Bedrock.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Bedrock"
        Description="Deterministic app generator — a thin client over the certified generator sidecar."
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- REQUIRED: Bedrock spawns a bundled node.exe sidecar (a child process) to run the
         certified generator. Full-trust is mandatory for that; runFullTrust is a
         restricted capability that needs a Store justification (see README.md). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
