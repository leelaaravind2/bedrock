{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thraksha",
  "version": "0.1.0",
  "identifier": "com.thraksha.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run sync-gen"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Thraksha",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": ["resources/gen/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
